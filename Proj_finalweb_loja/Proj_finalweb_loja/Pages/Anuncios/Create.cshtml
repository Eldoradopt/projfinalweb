@page
@model Proj_finalweb_loja.Pages.Anuncios.CreateModel
@{
    ViewData["Title"] = "Criar Anúncio";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <!-- Breadcrumb navigation -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none text-muted">Início</a></li>
                <li class="breadcrumb-item"><a asp-page="/Anuncios/Index" class="text-decoration-none text-muted">Artigos</a></li>
                <li class="breadcrumb-item active fw-bold text-primary" aria-current="page">Vender Artigo</li>
            </ol>
        </nav>

        <!-- Card Container -->
        <div class="bg-white border border-light p-4 p-md-5 shadow-sm" style="border-radius: var(--radius-lg);">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="bg-primary-light rounded-circle p-3 text-primary d-flex align-items-center justify-content-center" style="background-color: var(--clr-primary-light); width: 60px; height: 60px;">
                    <i class="bi bi-tag fs-2" style="color: var(--clr-primary);"></i>
                </div>
                <div>
                    <h1 class="fw-extrabold h3 mb-1">Publicar Novo Anúncio</h1>
                    <p class="text-muted small mb-0">Preenche os campos abaixo para divulgar o teu artigo a toda a comunidade do IPT.</p>
                </div>
            </div>
            
            @if (!User.Identity?.IsAuthenticated ?? true)
            {
                <div class="alert alert-info border-0 shadow-sm d-flex align-items-center gap-3 mb-4" style="background-color: var(--clr-primary-light); color: var(--clr-primary) !important; border-radius: var(--radius-md);">
                    <i class="bi bi-info-circle-fill fs-4" style="color: var(--clr-primary);"></i>
                    <div class="text-dark">
                        <strong>Modo de Demonstração Ativo:</strong> Estás a publicar sem sessão iniciada. O teu anúncio será automaticamente associado ao <strong>Vendedor Demo</strong> para que possas testar o funcionamento imediatamente!
                    </div>
                </div>
            }

            <form method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                <!-- 1. Categoria & Preço Row -->
                <div class="row g-4 mb-4">
                    <div class="col-md-7">
                        <label asp-for="Input.CategoriaFK" class="form-label fw-bold small text-uppercase tracking-wider text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-grid text-muted"></i></span>
                            <select asp-for="Input.CategoriaFK" asp-items="Model.CategoriasList" class="form-select border-start-0 py-2" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;">
                                <option value="">Escolhe uma subcategoria...</option>
                            </select>
                        </div>
                        <span asp-validation-for="Input.CategoriaFK" class="text-danger small"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="Input.Preco" class="form-label fw-bold small text-uppercase tracking-wider text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 fw-bold text-muted">€</span>
                            <input asp-for="Input.Preco" class="form-control border-start-0 py-2" type="number" step="0.01" min="0.01" placeholder="0.00" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;" />
                        </div>
                        <span asp-validation-for="Input.Preco" class="text-danger small"></span>
                    </div>
                </div>

                <!-- 2. Título -->
                <div class="mb-4">
                    <label asp-for="Input.Titulo" class="form-label fw-bold small text-uppercase tracking-wider text-muted"></label>
                    <input asp-for="Input.Titulo" class="form-control py-2" placeholder="Ex: Computador Portátil Lenovo ThinkPad em bom estado" style="border-radius: var(--radius-md);" />
                    <span asp-validation-for="Input.Titulo" class="text-danger small"></span>
                </div>

                <!-- 3. Descrição -->
                <div class="mb-4">
                    <label asp-for="Input.Descricao" class="form-label fw-bold small text-uppercase tracking-wider text-muted"></label>
                    <textarea asp-for="Input.Descricao" rows="5" class="form-control" placeholder="Descreve o teu produto. Inclui detalhes como: marcas de uso, acessórios incluídos, motivos da venda, onde podes entregar em Tomar..." style="border-radius: var(--radius-md);"></textarea>
                    <span asp-validation-for="Input.Descricao" class="text-danger small"></span>
                </div>

                <!-- 4. Estado do Produto (Enum Select) -->
                <div class="mb-4">
                    <label asp-for="Input.EstadoProduto" class="form-label fw-bold small text-uppercase tracking-wider text-muted"></label>
                    <select asp-for="Input.EstadoProduto" class="form-select py-2" style="border-radius: var(--radius-md);">
                        <option value="0">Novo (na caixa selada)</option>
                        <option value="1">Como Novo (sem marcas de uso)</option>
                        <option value="2">Em Bom Estado (pequenas marcas normais)</option>
                        <option value="3">Usado (marcas visíveis mas 100% funcional)</option>
                        <option value="4">Para Peças (danificado ou não funcional)</option>
                    </select>
                    <span asp-validation-for="Input.EstadoProduto" class="text-danger small"></span>
                </div>

                <!-- 5. Upload / Imagem -->
                <div class="card border border-light bg-light p-4 mb-4" style="border-radius: var(--radius-lg);">
                    <h6 class="fw-bold mb-3" style="color: var(--clr-primary);"><i class="bi bi-images"></i> Fotografia do Produto</h6>
                    
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Input.ImagemFicheiro" class="form-label fw-bold small text-uppercase tracking-wider text-muted"></label>
                            <input asp-for="Input.ImagemFicheiro" class="form-control py-2" type="file" accept="image/*" id="imageFileInput" style="border-radius: var(--radius-md);" />
                            <div class="form-text small text-muted">Carrega um ficheiro do teu computador (PNG, JPG).</div>
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="Input.ImagemUrl" class="form-label fw-bold small text-uppercase tracking-wider text-muted"></label>
                            <input asp-for="Input.ImagemUrl" class="form-control py-2" placeholder="https://exemplo.com/foto.jpg" id="imageUrlInput" style="border-radius: var(--radius-md);" />
                            <div class="form-text small text-muted">Ou cola um link de imagem direta da internet.</div>
                        </div>
                    </div>

                    <!-- Image Preview Area -->
                    <div class="mt-4 text-center d-none" id="imagePreviewContainer">
                        <span class="d-block fw-bold small text-uppercase tracking-wider text-muted mb-2">Pré-visualização</span>
                        <img id="imagePreview" src="#" alt="Pré-visualização da imagem" class="img-thumbnail shadow-sm" style="max-height: 200px; object-fit: cover; border-radius: var(--radius-md);" />
                    </div>
                </div>

                <!-- 6. Tags -->
                <div class="mb-4">
                    <label asp-for="Input.TagsInput" class="form-label fw-bold small text-uppercase tracking-wider text-muted"></label>
                    <input asp-for="Input.TagsInput" id="tagsInput" class="form-control py-2" placeholder="Ex: Apple, iPhone, Gaming, Promoção (separadas por vírgula)" style="border-radius: var(--radius-md);" />
                    <span asp-validation-for="Input.TagsInput" class="text-danger small"></span>
                    
                    @if (Model.TodasAsTags != null && Model.TodasAsTags.Any())
                    {
                        <div class="mt-2">
                            <span class="d-block text-muted small mb-2"><i class="bi bi-lightbulb-fill text-warning"></i> Tags existentes (clica para adicionar/remover):</span>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var tag in Model.TodasAsTags)
                                {
                                    <button type="button" class="btn btn-sm btn-light border tag-suggestion-btn py-1 px-3" data-tag-name="@tag.Nome" style="border-radius: 20px; font-size: 0.8rem;">
                                        @if (tag.EColecaoEspecial)
                                        {
                                            <i class="bi bi-@(tag.Icone ?? "star-fill") me-1" style="color: @(tag.CorHex ?? "var(--clr-primary)");"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-tag-fill text-muted me-1"></i>
                                        }
                                        @tag.Nome
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Submit and Cancel Buttons -->
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-3 mt-4">
                    <a asp-page="/Index" class="btn btn-premium-outline order-2 order-sm-1">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-premium order-1 order-sm-2">
                        <i class="bi bi-check-circle"></i> Publicar Anúncio
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Simple JS for Image Preview
        const fileInput = document.getElementById('imageFileInput');
        const urlInput = document.getElementById('imageUrlInput');
        const previewContainer = document.getElementById('imagePreviewContainer');
        const previewImg = document.getElementById('imagePreview');

        fileInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                    previewContainer.classList.remove('d-none');
                }
                reader.readAsDataURL(file);
                urlInput.value = ''; // Clear URL input if file is picked
            } else {
                hidePreviewIfEmpty();
            }
        });

        urlInput.addEventListener('input', function() {
            const url = this.value.trim();
            if (url) {
                previewImg.src = url;
                previewContainer.classList.remove('d-none');
                fileInput.value = ''; // Clear File input if URL is entered
            } else {
                hidePreviewIfEmpty();
            }
        });

        // Simple JS for Tag suggestions helper
        const tagsInput = document.getElementById('tagsInput');
        const suggestionBtns = document.querySelectorAll('.tag-suggestion-btn');

        suggestionBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const tagName = this.getAttribute('data-tag-name');
                let currentVal = tagsInput.value.trim();
                
                // Parse existing tags
                let tags = currentVal ? currentVal.split(',').map(t => t.trim()) : [];
                
                // If tag not already in list, add it
                if (!tags.some(t => t.toLowerCase() === tagName.toLowerCase())) {
                    tags.push(tagName);
                    tagsInput.value = tags.join(', ');
                    this.classList.remove('btn-light');
                    this.classList.add('btn-primary', 'text-white');
                } else {
                    // Remove tag if clicked again (toggle behavior)
                    tags = tags.filter(t => t.toLowerCase() !== tagName.toLowerCase());
                    tagsInput.value = tags.join(', ');
                    this.classList.remove('btn-primary', 'text-white');
                    this.classList.add('btn-light');
                }
            });
        });
    </script>
}
