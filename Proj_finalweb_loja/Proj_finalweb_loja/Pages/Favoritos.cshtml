@page
@model Proj_finalweb_loja.Pages.FavoritosModel
@{
    ViewData["Title"] = "Os Meus Favoritos";
}

<div class="container my-5">
    <div class="d-flex align-items-center gap-3 mb-4">
        <i class="bi bi-heart-fill text-danger fs-2"></i>
        <h1 class="fw-bold mb-0">Os Meus Favoritos</h1>
    </div>

    @if (!Model.MeusFavoritos.Any())
    {
        <div class="text-center py-5 bg-light rounded shadow-sm">
            <i class="bi bi-heart text-muted display-1 mb-3 d-block"></i>
            <p class="text-muted fs-5">Ainda não adicionaste nenhum artigo aos teus favoritos.</p>
            <a asp-page="/Anuncios/Index" class="btn btn-premium mt-2">Explorar Artigos</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var artigo in Model.MeusFavoritos)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 premium-card">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@artigo.Titulo</h5>
                            <p class="text-premium font-weight-bold fs-5 mb-2">@artigo.Preco.ToString("C")</p>
                            <p class="card-text text-muted small text-truncate">@artigo.Descricao</p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0 pb-3">
                            <a asp-page="/Anuncios/Details" asp-route-id="@artigo.Id" class="btn btn-outline-dark btn-sm w-100 rounded-pill">Ver Detalhes</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>