@page
@model IndexModel
@{
    ViewData["Title"] = "Início";
}

<!-- Hero Banner Section -->
<section class="hero-premium position-relative" style="background: linear-gradient(rgba(11, 61, 36, 0.9), rgba(19, 88, 53, 0.85)), url('https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1600&q=80'); background-size: cover; background-position: center; border-bottom: 5px solid var(--gold-deep); color: white;">
    <div class="row align-items-center py-4">
        <div class="col-lg-12 text-center py-5">
            <div class="quran-callout-box mx-auto mb-4" style="background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(223, 186, 107, 0.3); border-left: 4px solid var(--gold-light); border-right: 4px solid var(--gold-light); padding: 25px; border-radius: 8px; max-width: 800px; backdrop-filter: blur(4px);">
                <div class="quran-arabic mb-2" style="font-size: 1.8rem; color: var(--gold-shimmer); font-family: 'Amiri', serif; direction: rtl;">وَلَا تُسْرِفُوا ۚ إِنَّهُ لَا يُحِبُّ الْمُسْرِفِينَ</div>
                <div class="quran-translation italic" style="font-size: 1.1rem; color: #f0f0f0;">"And waste not by extravagance. Verily, He (Allah) likes not the wasteful."</div>
                <span class="quran-reference d-block mt-2 small text-uppercase" style="color: var(--gold-light); letter-spacing: 1px;">Surah Al-An'am [6:141]</span>
            </div>
            
            <h1 class="display-4 fw-extrabold mb-3 text-white">
                Honorable, Waste-Free Commerce
            </h1>
            <p class="lead mb-4 fs-5 text-white-50 mx-auto" style="max-width: 700px;">
                Give pre-loved goods a second life. Find unique items enriched with Barakah, traded with absolute transparency, integrity, and Islamic compliance.
            </p>
            <div class="d-flex justify-content-center flex-wrap gap-3">
                <a class="btn btn-premium btn-lg" asp-page="/Anuncios/Create">
                    <i class="bi bi-plus-circle"></i> Start Selling
                </a>
                <a class="btn btn-outline-light btn-lg" asp-page="/Anuncios/Index">
                    <i class="bi bi-search"></i> Browse Items
                </a>
            </div>
        </div>
    </div>
</section>

<div class="decorative-divider text-center my-5" style="color: var(--gold-deep); font-size: 1.5rem;">
    ✦ Blessed Listings Available Today ✦
</div>

<!-- Categories Section (No major logic changes, just title) -->
<section class="mb-5 container">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <span class="text-primary fw-bold text-uppercase tracking-wider" style="font-size: 0.8rem; letter-spacing: 0.05em;">Verticals</span>
            <h2 class="fw-bold mt-1">Explore by Category</h2>
        </div>
        <a class="btn btn-link text-primary nav-link-premium p-2 fw-semibold" asp-page="/Anuncios/Index">View All <i class="bi bi-arrow-right"></i></a>
    </div>

    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-5 g-4 justify-content-center">
        @if (Model.CategoriasPrincipais != null && Model.CategoriasPrincipais.Any())
        {
            @foreach (var cat in Model.CategoriasPrincipais)
            {
                <div class="col">
                    <a class="category-circle-link" asp-page="/Anuncios/Index" asp-route-categoriaId="@cat.Id">
                        <div class="category-icon-wrapper">
                            <i class="bi bi-@cat.Icone"></i>
                        </div>
                        <span class="category-circle-name">@cat.Nome</span>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted py-4">
                <i class="bi bi-info-circle fs-3 mb-2 d-block"></i>
                Nenhuma categoria disponível no momento. Run migrations and check setup.
            </div>
        }
    </div>
</section>

<!-- Coleções Especiais Section -->
@if (Model.ColecoesDestaque != null && Model.ColecoesDestaque.Any())
{
    <section class="mb-5 py-4 border-top">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="text-primary fw-bold text-uppercase tracking-wider" style="font-size: 0.8rem; letter-spacing: 0.05em;">✨ Exclusivo</span>
                <h2 class="fw-bold mt-1">Coleções em Destaque</h2>
            </div>
            <a class="btn btn-link text-primary nav-link-premium p-2 fw-semibold" asp-page="/Colecoes/Index">Ver Todas <i class="bi bi-arrow-right"></i></a>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
            @foreach (var col in Model.ColecoesDestaque)
            {
                var cor = col.CorHex ?? "#6366f1";
                var icone = col.Icone ?? "tag";
                var count = col.AnuncioTags.Count;
                
                <div class="col">
                    <a asp-page="/Colecoes/Detalhes" asp-route-tagId="@col.Id" class="text-decoration-none">
                        <div class="d-flex align-items-center gap-3 p-3 bg-white border border-light shadow-sm position-relative overflow-hidden col-card"
                             style="border-radius: var(--radius-lg); transition: transform 0.2s, box-shadow 0.2s;">
                            <!-- Tiny background glow -->
                            <div style="position: absolute; right: -10px; bottom: -10px; font-size: 4rem; color: @cor; opacity: 0.08;">
                                <i class="bi bi-@icone"></i>
                            </div>
                            <div class="rounded d-flex align-items-center justify-content-center text-white"
                                 style="width: 48px; height: 48px; background: linear-gradient(135deg, @cor, @(cor)cc); flex-shrink: 0;">
                                <i class="bi bi-@icone" style="font-size: 1.5rem;"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">@col.Nome</h6>
                                <span class="text-muted small">@count artigos</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
}

<style>
    .col-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.08) !important;
    }
</style>

<!-- Recent Listings Section -->
<section class="mb-5 py-4 border-top">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <span class="text-primary fw-bold text-uppercase tracking-wider" style="font-size: 0.8rem; letter-spacing: 0.05em;">Novidades</span>
            <h2 class="fw-bold mt-1">Artigos Recém Adicionados</h2>
        </div>
        <a class="btn btn-link text-primary nav-link-premium p-2 fw-semibold" asp-page="/Anuncios/Index">Ver Todos <i class="bi bi-arrow-right"></i></a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
        @if (Model.AnunciosRecentes != null && Model.AnunciosRecentes.Any())
        {
            @foreach (var ad in Model.AnunciosRecentes)
            {
                var principalImg = ad.Imagens.FirstOrDefault(i => i.Principal) ?? ad.Imagens.FirstOrDefault() ?? new Imagem { CaminhoFicheiro = "https://images.unsplash.com/photo-1531403009284-440f080d1e12?auto=format&fit=crop&w=600&q=80" };
                
                <div class="col">
                    <div class="card-premium">
                        <div class="card-img-container">
                            <span class="badge-premium">
                                @{
                                    var estadoName = ad.EstadoProduto.ToString();
                                    switch (ad.EstadoProduto)
                                    {
                                        case EstadoProduto.Novo: estadoName = "Novo"; break;
                                        case EstadoProduto.ComoNovo: estadoName = "Como Novo"; break;
                                        case EstadoProduto.BomEstado: estadoName = "Bom Estado"; break;
                                        case EstadoProduto.Usado: estadoName = "Usado"; break;
                                        case EstadoProduto.ParaPecas: estadoName = "Para Peças"; break;
                                    }
                                }
                                @estadoName
                            </span>
                            
                            <button class="btn-favorite-badge shadow-sm" type="button" title="Adicionar aos favoritos">
                                <i class="bi bi-heart"></i>
                            </button>
                            
                            <img src="@principalImg.CaminhoFicheiro" alt="@ad.Titulo" class="card-img-premium" />
                        </div>
                        <div class="card-body-premium">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="card-category-premium mb-0">@ad.Categoria?.Nome</div>
                                @if (ad.AnuncioTags != null && ad.AnuncioTags.Any())
                                {
                                    <div class="d-flex gap-1 flex-wrap justify-content-end">
                                        @foreach (var at in ad.AnuncioTags.Take(2))
                                        {
                                            var tag = at.Tag;
                                            <span class="badge rounded-pill fw-bold" style="font-size:0.65rem; background:@(tag.EColecaoEspecial ? (tag.CorHex ?? "#6366f1") : "#f3f4f6"); color:@(tag.EColecaoEspecial ? "#ffffff" : "#4b5563");">
                                                @tag.Nome
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                            <h5 class="card-title-premium">
                                <a asp-page="/Anuncios/Details" asp-route-id="@ad.Id" class="text-decoration-none text-dark hover-primary">
                                    @ad.Titulo
                                </a>
                            </h5>
                            <div class="card-price-premium mt-auto">
                                <span>@ad.Preco.ToString("N2") €</span>
                            </div>
                        </div>
                        <div class="card-footer-premium">
                            <span class="d-flex align-items-center gap-1">
                                <i class="bi bi-geo-alt"></i> @ad.Vendedor?.Cidade
                            </span>
                            <span class="d-flex align-items-center gap-1">
                                <i class="bi bi-clock"></i> @ad.DataPublicacao.ToString("dd/MM")
                            </span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted py-5">
                <i class="bi bi-shop fs-2 mb-2 d-block"></i>
                Ainda não há artigos à venda. Sê o primeiro a publicar um artigo!
            </div>
        }
    </div>
</section>

<!-- Core Pillars Section -->
<section class="py-5" style="background-color: var(--clr-primary-light); border-top: 1px solid rgba(184, 144, 71, 0.2);">
    <div class="container">
        <div class="text-center mb-5">
            <span class="text-primary fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.05em;">Our Ethos</span>
            <h2 class="fw-bold mt-1 text-primary">Core Pillars of Barakah</h2>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="bg-white p-4 h-100 text-center shadow-sm" style="border-top: 4px solid var(--gold-deep); border-radius: var(--radius-lg);">
                    <div class="fs-1 mb-3">🌿</div>
                    <h5 class="fw-bold text-primary">Eco-Sunnah Living</h5>
                    <p class="text-muted small">The Prophet ﷺ encouraged preservation and moderation. Reusing items honors creation and actively prevents excess waste (Israf).</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="bg-white p-4 h-100 text-center shadow-sm" style="border-top: 4px solid var(--gold-deep); border-radius: var(--radius-lg);">
                    <div class="fs-1 mb-3">⚖️</div>
                    <h5 class="fw-bold text-primary">Honest Exchange</h5>
                    <p class="text-muted small">Every defect is explicitly listed. Our sellers pledge truthfulness in weights and quality, fulfilling sacred transactional trusts.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="bg-white p-4 h-100 text-center shadow-sm" style="border-top: 4px solid var(--gold-deep); border-radius: var(--radius-lg);">
                    <div class="fs-1 mb-3">🤝</div>
                    <h5 class="fw-bold text-primary">Built-In Barakah</h5>
                    <p class="text-muted small">A portion of our community growth efforts are focused on local neighborly support and circular economy sustainability.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Hadith Reminder Section -->
<section class="spiritual-reminder-section py-5 text-center" style="background: linear-gradient(135deg, #f4eee1, #e9dfcb); border-top: 2px solid var(--gold-deep); border-bottom: 2px solid var(--gold-deep);">
    <div class="container">
        <div class="quran-arabic mb-3" style="color: var(--clr-primary); font-size: 1.6rem; font-family: 'Amiri', serif;">وَكُلُوا وَاشْرَبُوا وَلَا تُسْرِفُوا إِنَّهُ لَا يُحِبُّ الْمُسْرِفِينَ</div>
        <p class="italic text-dark mb-2" style="font-size: 1.1rem; max-width: 800px; margin: 0 auto;">"The Messenger of Allah (ﷺ) passed by Sa’d when he was performing ablution, and he said: 'What is this extravagance?' He said: 'Can there be extravagance in ablution?' He said: 'Yes, even if you are on the bank of a flowing river.'"</p>
        <span class="text-uppercase fw-bold text-primary small" style="letter-spacing: 2px;">— Sunan Ibn Majah 425</span>
    </div>
</section>
