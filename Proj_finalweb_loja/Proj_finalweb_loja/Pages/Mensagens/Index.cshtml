@page
@model Proj_finalweb_loja.Pages.Mensagens.IndexModel
@{
    ViewData["Title"] = "O Meu Chat";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-9">
        <!-- Breadcrumb navigation -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none text-muted">Início</a></li>
                <li class="breadcrumb-item active fw-bold text-primary" aria-current="page">Mensagens</li>
            </ol>
        </nav>

        <!-- Admin / Mode Warning -->
        @if (!User.Identity?.IsAuthenticated ?? true)
        {
            <div class="alert alert-info border-0 shadow-sm d-flex align-items-center gap-3 mb-4" style="background-color: var(--clr-primary-light); color: var(--clr-primary) !important; border-radius: var(--radius-md);">
                <i class="bi bi-info-circle-fill fs-4" style="color: var(--clr-primary);"></i>
                <div class="text-dark">
                    <strong>Modo de Demonstração Ativo:</strong> Estás a ver as mensagens como o utilizador de teste <strong>João Pereira</strong>. Inicia sessão para veres o teu chat pessoal!
                </div>
            </div>
        }

        <!-- Chat Container -->
        <div class="bg-white border border-light shadow-sm" style="border-radius: var(--radius-lg); overflow: hidden;">
            <div class="p-4 border-bottom border-light bg-light">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary text-white rounded-circle p-2.5 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-chat-left-text fs-4"></i>
                    </div>
                    <div>
                        <h1 class="fw-extrabold h4 mb-0">Centro de Mensagens</h1>
                        <p class="text-muted small mb-0">Conversas ativas com outros estudantes e vendedores sobre artigos do Bazar.</p>
                    </div>
                </div>
            </div>

            <div class="list-group list-group-flush">
                @if (!Model.Threads.Any())
                {
                    <div class="text-center py-5 px-4 my-3 text-muted">
                        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-chat-dots fs-1" style="color: var(--clr-text-muted); opacity: 0.5;"></i>
                        </div>
                        <h5 class="fw-bold mb-1">Sem conversas ativas</h5>
                        <p class="text-muted small mb-4">Ainda não enviaste ou recebeste nenhuma mensagem no BazarIPT.</p>
                        <a asp-page="/Anuncios/Index" class="btn btn-premium btn-sm">
                            <i class="bi bi-search"></i> Procurar Artigos
                        </a>
                    </div>
                }
                else
                {
                    @foreach (var thread in Model.Threads)
                    {
                        var adImg = thread.Anuncio?.Imagens.FirstOrDefault(i => i.Principal)?.CaminhoFicheiro 
                                    ?? "https://images.unsplash.com/photo-1531403009284-440f080d1e12?auto=format&fit=crop&w=600&q=80";
                        var isUnread = thread.UnreadCount > 0;

                        <a asp-page="/Mensagens/Chat" asp-route-anuncioId="@thread.Anuncio?.Id" asp-route-destinatarioId="@thread.OtherUser?.Id" 
                           class="list-group-item list-group-item-action p-4 border-bottom border-light transition-all d-flex align-items-start gap-3 @(isUnread ? "bg-primary-light" : "")"
                           style="background-color: @(isUnread ? "rgba(79, 70, 229, 0.03)" : "transparent");">
                            
                            <!-- Product Mini Image -->
                            <div class="position-relative flex-shrink-0">
                                <img src="@adImg" alt="@thread.Anuncio?.Titulo" class="img-thumbnail" style="width: 65px; height: 65px; object-fit: cover; border-radius: var(--radius-sm);" />
                                @if (isUnread)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white" style="font-size: 0.7rem; padding: 0.35em 0.6em;">
                                        @thread.UnreadCount
                                    </span>
                                }
                            </div>

                            <!-- Thread Details -->
                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex justify-content-between align-items-baseline mb-1">
                                    <h6 class="fw-bold mb-0 text-dark">
                                        @thread.OtherUser?.Nome 
                                        <span class="fw-normal text-muted small ms-1">(@thread.OtherUser?.Cidade)</span>
                                    </h6>
                                    <span class="text-muted small" style="font-size: 0.75rem;">
                                        @thread.LastMessage.DataEnvio.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>

                                <div class="text-primary small fw-semibold mb-1">
                                    <i class="bi bi-tag-fill text-muted" style="font-size: 0.8rem;"></i> @thread.Anuncio?.Titulo
                                </div>

                                <p class="text-muted small mb-0 text-truncate @(isUnread ? "fw-bold text-dark" : "")" style="max-width: 90%;">
                                    @if (thread.LastMessage.RemetenteFK == Model.CurrentUser.Id)
                                    {
                                        <span class="text-muted"><i class="bi bi-reply"></i> Tu: </span>
                                    }
                                    @thread.LastMessage.Conteudo
                                </p>
                            </div>
                            
                            <!-- Arrow indicator -->
                            <div class="align-self-center text-muted">
                                <i class="bi bi-chevron-right fs-5"></i>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>
