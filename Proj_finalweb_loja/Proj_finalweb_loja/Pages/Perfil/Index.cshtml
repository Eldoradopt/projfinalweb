@page
@model Proj_finalweb_loja.Pages.Perfil.IndexModel
@{
    ViewData["Title"] = "Perfil de " + Model.PerfilUser.Nome;
}

<div class="container py-4">
    <!-- Profile Header Background Cover -->
    <div class="position-relative mb-5" style="height: 150px; background: linear-gradient(135deg, var(--clr-primary), var(--clr-secondary)); border-radius: var(--radius-lg);">
        <div class="position-absolute start-0 bottom-0 translate-middle-y ms-4 d-flex align-items-end gap-3 flex-wrap" style="transform: translateY(30%);">
            <!-- User Avatar -->
            @if (!string.IsNullOrWhiteSpace(Model.PerfilUser.FotoPerfilPath))
            {
                <img src="@Model.PerfilUser.FotoPerfilPath" alt="@Model.PerfilUser.Nome" class="rounded-circle border border-4 border-white shadow-md bg-white" style="width: 110px; height: 110px; object-fit: cover;" />
            }
            else
            {
                <div class="bg-primary text-white rounded-circle border border-4 border-white shadow-md d-flex align-items-center justify-content-center fw-bold" style="width: 110px; height: 110px; font-size: 2.5rem; background: linear-gradient(135deg, var(--clr-primary), var(--clr-secondary));">
                    @Model.PerfilUser.Nome.Substring(0, 1).ToUpper()
                </div>
            }
            
            <div class="mb-2">
                <h1 class="h3 fw-extrabold text-dark mb-1">@Model.PerfilUser.Nome</h1>
                <span class="badge bg-light text-muted border border-light" style="border-radius: var(--radius-sm);">
                    <i class="bi bi-calendar3"></i> Membro desde @Model.PerfilUser.DataRegisto.ToString("MMMM 'de' yyyy")
                </span>
            </div>
        </div>
    </div>

    <!-- Spacing adjustment for cover photo overlap -->
    <div class="my-5 pt-3"></div>

    <div class="row g-4">
        <!-- Left Side: User Info & Reputation (4 Cols) -->
        <div class="col-lg-4">
            <!-- Contact details -->
            <div class="bg-white border border-light p-4 mb-4 shadow-sm" style="border-radius: var(--radius-lg);">
                <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-info-circle text-primary"></i> Informações</h5>
                
                <ul class="list-unstyled mb-0 d-flex flex-column gap-3">
                    <li class="d-flex align-items-center gap-3">
                        <div class="bg-light text-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Localização</span>
                            <span class="fw-semibold">@(string.IsNullOrEmpty(Model.PerfilUser.Cidade) ? "Não especificada" : Model.PerfilUser.Cidade)</span>
                        </div>
                    </li>
                    <li class="d-flex align-items-center gap-3">
                        <div class="bg-light text-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="bi bi-telephone"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Contacto Telefónico</span>
                            @if (!string.IsNullOrEmpty(Model.PerfilUser.PhoneNumber))
                            {
                                <a href="tel:@Model.PerfilUser.PhoneNumber" class="fw-semibold text-decoration-none">@Model.PerfilUser.PhoneNumber</a>
                            }
                            else
                            {
                                <span class="text-muted">Não disponível</span>
                            }
                        </div>
                    </li>
                </ul>
            </div>

            <!-- Reputation Card -->
            <div class="bg-white border border-light p-4 shadow-sm" style="border-radius: var(--radius-lg);">
                <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-star text-primary"></i> Reputação</h5>
                
                <div class="text-center py-3">
                    @if (Model.TotalAvaliacoes > 0)
                    {
                        <div class="h1 fw-extrabold text-dark mb-1">@Model.MediaAvaliacoes.ToString("0.0") <span class="fs-5 text-muted">/ 5</span></div>
                        
                        <div class="mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(Model.MediaAvaliacoes))
                                {
                                    <i class="bi bi-star-fill text-warning fs-4"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-muted fs-4" style="opacity: 0.3;"></i>
                                }
                            }
                        </div>
                        
                        <span class="text-muted small">Baseado em @Model.TotalAvaliacoes @(Model.TotalAvaliacoes == 1 ? "avaliação" : "avaliações")</span>
                    }
                    else
                    {
                        <div class="text-center py-2 text-muted">
                            <i class="bi bi-chat-left-heart fs-2 text-muted mb-2" style="opacity: 0.4;"></i>
                            <p class="small mb-0">Este vendedor ainda não recebeu nenhuma avaliação de compras concluídas.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Side: Listings & Reviews (8 Cols) -->
        <div class="col-lg-8">
            
            <!-- Tabs Header -->
            <ul class="nav nav-pills nav-fill bg-white border border-light p-1.5 mb-4 shadow-sm" id="profileTab" role="tablist" style="border-radius: var(--radius-md);">
                <li class="nav-item" role="presentation">
                    <button class="nav-link nav-link-premium active py-2.5 fw-bold" id="listings-tab" data-bs-toggle="tab" data-bs-target="#listings" type="button" role="tab" aria-controls="listings" aria-selected="true">
                        <i class="bi bi-grid-3x3-gap"></i> Artigos à Venda (@Model.AnunciosAtivos.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link nav-link-premium py-2.5 fw-bold" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab" aria-controls="reviews" aria-selected="false">
                        <i class="bi bi-chat-left-quote"></i> Avaliações (@Model.TotalAvaliacoes)
                    </button>
                </li>
            </ul>

            <!-- Tabs Content -->
            <div class="tab-content" id="profileTabContent">
                <!-- 1. Listings Tab -->
                <div class="tab-pane fade show active" id="listings" role="tabpanel" aria-labelledby="listings-tab">
                    @if (!Model.AnunciosAtivos.Any())
                    {
                        <div class="bg-white border border-light p-5 text-center text-muted shadow-sm" style="border-radius: var(--radius-lg);">
                            <i class="bi bi-box-seam fs-1 text-muted mb-2 d-block" style="opacity: 0.4;"></i>
                            <h5 class="fw-bold mb-1">Nenhum artigo disponível</h5>
                            <p class="small mb-0 text-muted">Este utilizador não tem anúncios ativos no momento.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4">
                            @foreach (var ad in Model.AnunciosAtivos)
                            {
                                var imagePath = ad.Imagens.FirstOrDefault(i => i.Principal)?.CaminhoFicheiro 
                                                ?? "https://images.unsplash.com/photo-1531403009284-440f080d1e12?auto=format&fit=crop&w=600&q=80";

                                <div class="col-md-6">
                                    <div class="card card-premium">
                                        <div class="card-img-container">
                                            <span class="badge-premium">@ad.EstadoProduto.ToString()</span>
                                            <img src="@imagePath" alt="@ad.Titulo" class="card-img-premium" />
                                        </div>
                                        <div class="card-body-premium">
                                            <div class="card-category-premium">@ad.Categoria?.Nome</div>
                                            <a asp-page="/Anuncios/Details" asp-route-id="@ad.Id" class="text-decoration-none text-dark">
                                                <h5 class="card-title-premium" title="@ad.Titulo">@ad.Titulo</h5>
                                            </a>
                                            <div class="card-price-premium">
                                                <span>@ad.Preco.ToString("N2") €</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- 2. Reviews Tab -->
                <div class="tab-pane fade" id="reviews" role="tabpanel" aria-labelledby="reviews-tab">
                    @if (!Model.PerfilUser.AvaliacoesRecebidas.Any())
                    {
                        <div class="bg-white border border-light p-5 text-center text-muted shadow-sm" style="border-radius: var(--radius-lg);">
                            <i class="bi bi-emoji-neutral fs-1 text-muted mb-2 d-block" style="opacity: 0.4;"></i>
                            <h5 class="fw-bold mb-1">Sem avaliações</h5>
                            <p class="small mb-0 text-muted">Este vendedor ainda não foi avaliado.</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var r in Model.PerfilUser.AvaliacoesRecebidas)
                            {
                                <div class="bg-white border border-light p-4 shadow-sm d-flex gap-3 align-items-start" style="border-radius: var(--radius-lg);">
                                    <!-- Reviewer Initials Avatar -->
                                    <div class="bg-primary-light text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 48px; height: 48px; background-color: var(--clr-primary-light);">
                                        @(!string.IsNullOrEmpty(r.Avaliador?.Nome) ? r.Avaliador.Nome.Substring(0, 1).ToUpper() : "A")
                                    </div>
                                    
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap">
                                            <h6 class="fw-bold text-dark mb-0">@r.Avaliador?.Nome</h6>
                                            <span class="text-muted small" style="font-size: 0.75rem;">@r.DataAvaliacao.ToString("dd/MM/yyyy")</span>
                                        </div>

                                        <!-- Stars rating -->
                                        <div class="mb-2">
                                            @for (int j = 1; j <= 5; j++)
                                            {
                                                if (j <= r.Nota)
                                                {
                                                    <i class="bi bi-star-fill text-warning" style="font-size: 0.85rem;"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star text-muted" style="font-size: 0.85rem; opacity: 0.3;"></i>
                                                }
                                            }
                                        </div>

                                        <p class="text-muted small mb-0" style="line-height: 1.5;">@r.Comentario</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>
