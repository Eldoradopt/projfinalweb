@page
@model Proj_finalweb_loja.Pages.Perfil.MeusAnunciosModel
@{
    ViewData["Title"] = "Os Meus Anúncios";
}

<div class="container py-4">
    <!-- Header Dashboard Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none text-muted">Início</a></li>
                    <li class="breadcrumb-item active fw-bold text-primary" aria-current="page">Os Meus Anúncios</li>
                </ol>
            </nav>
            <h1 class="fw-extrabold h2 mb-1">Painel do Vendedor</h1>
            <p class="text-muted small mb-0">Gere as tuas publicações, acompanha as vendas e altera o estado dos teus artigos.</p>
        </div>
        
        <a asp-page="/Anuncios/Create" class="btn btn-premium">
            <i class="bi bi-plus-circle"></i> Novo Anúncio
        </a>
    </div>

    <!-- Mode Warning -->
    @if (!User.Identity?.IsAuthenticated ?? true)
    {
        <div class="alert alert-info border-0 shadow-sm d-flex align-items-center gap-3 mb-4" style="background-color: var(--clr-primary-light); color: var(--clr-primary) !important; border-radius: var(--radius-md);">
            <i class="bi bi-info-circle-fill fs-4" style="color: var(--clr-primary);"></i>
            <div class="text-dark">
                <strong>Modo de Demonstração Ativo:</strong> Estás a gerir os anúncios do <strong>Vendedor Demo</strong>. Inicia sessão para acederes ao teu painel exclusivo!
            </div>
        </div>
    }

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-center gap-3 mb-4" role="alert" style="border-radius: var(--radius-md);">
            <i class="bi bi-check-circle-fill fs-4 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <!-- Dashboard Statistics Widgets Grid -->
    <div class="row g-4 mb-4">
        <!-- Revenue widget -->
        <div class="col-md-4">
            <div class="bg-white border border-light p-4 shadow-sm d-flex align-items-center justify-content-between" style="border-radius: var(--radius-lg);">
                <div>
                    <span class="text-muted small d-block mb-1 font-weight-bold text-uppercase tracking-wider">Volume de Vendas</span>
                    <h3 class="fw-extrabold mb-0 text-success">@Model.TotalVendido.ToString("N2") €</h3>
                </div>
                <div class="bg-success-light text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="background-color: rgba(16, 185, 129, 0.1); width: 56px; height: 56px;">
                    <i class="bi bi-currency-euro fs-3"></i>
                </div>
            </div>
        </div>
        
        <!-- Active ads widget -->
        <div class="col-md-4">
            <div class="bg-white border border-light p-4 shadow-sm d-flex align-items-center justify-content-between" style="border-radius: var(--radius-lg);">
                <div>
                    <span class="text-muted small d-block mb-1 font-weight-bold text-uppercase tracking-wider">Artigos Ativos</span>
                    <h3 class="fw-extrabold mb-0 text-primary">@Model.TotalAtivos</h3>
                </div>
                <div class="bg-primary-light text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="background-color: var(--clr-primary-light); width: 56px; height: 56px;">
                    <i class="bi bi-grid fs-3"></i>
                </div>
            </div>
        </div>

        <!-- Reserved ads widget -->
        <div class="col-md-4">
            <div class="bg-white border border-light p-4 shadow-sm d-flex align-items-center justify-content-between" style="border-radius: var(--radius-lg);">
                <div>
                    <span class="text-muted small d-block mb-1 font-weight-bold text-uppercase tracking-wider">Reservados</span>
                    <h3 class="fw-extrabold mb-0 text-warning">@Model.TotalReservados</h3>
                </div>
                <div class="bg-warning-light text-warning rounded-circle p-3 d-flex align-items-center justify-content-center" style="background-color: rgba(245, 158, 11, 0.1); width: 56px; height: 56px;">
                    <i class="bi bi-bookmark-dash fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Ads management table -->
    <div class="bg-white border border-light shadow-sm" style="border-radius: var(--radius-lg); overflow: hidden;">
        <div class="p-4 border-bottom border-light">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-list-task text-primary"></i> Os Meus Artigos Publicados</h5>
        </div>
        
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase tracking-wider small fw-bold text-muted" style="width: 100px;">Artigo</th>
                        <th class="py-3 text-uppercase tracking-wider small fw-bold text-muted">Título & Categoria</th>
                        <th class="py-3 text-uppercase tracking-wider small fw-bold text-muted">Preço</th>
                        <th class="py-3 text-uppercase tracking-wider small fw-bold text-muted">Visibilidade</th>
                        <th class="py-3 text-uppercase tracking-wider small fw-bold text-muted">Estado</th>
                        <th class="py-3 text-uppercase tracking-wider small fw-bold text-muted text-end pe-4" style="width: 320px;">Ações Rápidas</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.MeusAnuncios.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-box fs-1 d-block mb-2 text-muted" style="opacity: 0.5;"></i>
                                Ainda não publicaste nenhum artigo à venda.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.MeusAnuncios)
                        {
                            var principalImg = item.Imagens.FirstOrDefault(i => i.Principal)?.CaminhoFicheiro 
                                               ?? "https://images.unsplash.com/photo-1531403009284-440f080d1e12?auto=format&fit=crop&w=600&q=80";
                            
                            <tr>
                                <td class="ps-4">
                                    <img src="@principalImg" alt="@item.Titulo" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover; border-radius: var(--radius-sm);" />
                                </td>
                                <td>
                                    <a asp-page="/Anuncios/Details" asp-route-id="@item.Id" class="text-decoration-none fw-bold text-dark d-block">@item.Titulo</a>
                                    <span class="text-muted small">@item.Categoria?.Nome</span>
                                </td>
                                <td>
                                    <span class="fw-bold">@item.Preco.ToString("N2") €</span>
                                </td>
                                <td>
                                    <form method="post" asp-page-handler="ToggleActive" asp-route-id="@item.Id" class="d-inline">
                                        @if (item.Ativo)
                                        {
                                            <button type="submit" class="badge border-0 bg-success-light text-success px-2.5 py-1.5 fw-semibold d-inline-flex align-items-center gap-1" style="background-color: rgba(16, 185, 129, 0.1);">
                                                <i class="bi bi-eye-fill"></i> Ativo
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="badge border-0 bg-secondary-light text-muted px-2.5 py-1.5 fw-semibold d-inline-flex align-items-center gap-1" style="background-color: rgba(100, 116, 139, 0.1);">
                                                <i class="bi bi-eye-slash-fill"></i> Inativo
                                            </button>
                                        }
                                    </form>
                                </td>
                                <td>
                                    @if (item.Estado == EstadoAnuncio.Disponivel)
                                    {
                                        <span class="badge bg-success-light text-success px-2.5 py-1.5" style="background-color: rgba(16, 185, 129, 0.1);">Disponível</span>
                                    }
                                    else if (item.Estado == EstadoAnuncio.Reservado)
                                    {
                                        <span class="badge bg-warning-light text-warning px-2.5 py-1.5" style="background-color: rgba(245, 158, 11, 0.1);">Reservado</span>
                                    }
                                    else if (item.Estado == EstadoAnuncio.Vendido)
                                    {
                                        <span class="badge bg-secondary-light text-muted px-2.5 py-1.5" style="background-color: rgba(100, 116, 139, 0.1);">Vendido</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        @if (item.Estado == EstadoAnuncio.Disponivel)
                                        {
                                            <form method="post" asp-page-handler="MarkAsReserved" asp-route-id="@item.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-warning py-1 px-2" title="Marcar como Reservado">
                                                    <i class="bi bi-bookmark-dash"></i> Reservar
                                                </button>
                                            </form>
                                            
                                            <form method="post" asp-page-handler="MarkAsSold" asp-route-id="@item.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success py-1 px-2" title="Marcar como Vendido">
                                                    <i class="bi bi-check2-circle"></i> Vender
                                                </button>
                                            </form>
                                        }
                                        else if (item.Estado == EstadoAnuncio.Reservado)
                                        {
                                            <form method="post" asp-page-handler="MarkAsSold" asp-route-id="@item.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success py-1 px-2" title="Marcar como Vendido">
                                                    <i class="bi bi-check2-circle"></i> Vender
                                                </button>
                                            </form>
                                        }

                                        <a asp-page="/Anuncios/Edit" asp-route-id="@item.Id" class="btn btn-sm btn-premium-outline py-1 px-2" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        
                                        <a asp-page="/Anuncios/Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger py-1 px-2" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
