<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Al-Barakah Market</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Google Fonts for Arabic/Serif style -->
    <link href="https://fonts.googleapis.com/css2?family=Amiri&family=Georgia&display=swap" rel="stylesheet">
    
    <!-- Custom & Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Proj_finalweb_loja.styles.css" asp-append-version="true" />

    <style>
        :root {
            --clr-primary: #0b3d24;
            --clr-primary-light: #fbf9f4;
            --clr-secondary: #b89047;
            --gold-deep: #b89047;
            --gold-light: #dfba6b;
            --gold-shimmer: #f3e3bc;
            --clr-emerald-medium: #1b7245; /* Added for consistency */
            --clr-text-main: #2d312e;
            --radius-lg: 8px;
            --radius-md: 4px;
        }

        h1, h2, h3, h4, h5, h6, .navbar-brand strong {
            font-family: 'Amiri', serif; /* Arabic-themed font for headings */
        }

        body {
            font-family: 'Georgia', serif;
            background-color: var(--clr-primary-light); /* Light beige base */
            background-image: linear-gradient(45deg, rgba(223, 186, 107, 0.05) 25%, transparent 25%, transparent 75%, rgba(223, 186, 107, 0.05) 75%, rgba(223, 186, 107, 0.05)), linear-gradient(-45deg, rgba(223, 186, 107, 0.05) 25%, transparent 25%, transparent 75%, rgba(223, 186, 107, 0.05) 75%, rgba(223, 186, 107, 0.05));
            background-size: 20px 20px; /* Subtle pattern */
            color: var(--clr-text-main);
        }

        /* Global Card Styling */
        .card-premium { /* Changed card background to light beige */
            background-color: var(--clr-primary-light);
            border: 1px solid rgba(184, 144, 71, 0.15);
            border-top: 3px solid var(--gold-deep); /* Accent border */
            border-radius: var(--radius-lg);
            box-shadow: 0 10px 30px rgba(11, 61, 36, 0.05);
            transition: all 0.3s ease;
        }

        /* Global Button Styling */
        .btn-premium {
            background: linear-gradient(135deg, var(--clr-primary), #135835);
            color: var(--gold-shimmer) !important;
            padding: 10px 22px;
            border-radius: 4px;
            text-decoration: none;
            font-weight: bold;
            font-size: 0.95rem;
            border: 1px solid var(--gold-deep);
            box-shadow: 0 4px 12px rgba(184, 144, 71, 0.2);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-premium:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(184, 144, 71, 0.35);
            background: linear-gradient(135deg, var(--gold-light), var(--gold-deep));
            color: var(--clr-primary) !important; /* Keep text color consistent */
        }

        .btn-premium-outline {
            border: 1px solid var(--gold-deep);
            color: var(--gold-deep);
            background-color: transparent;
            padding: 10px 22px;
            border-radius: 4px;
            font-weight: bold;
            font-size: 0.95rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-premium-outline:hover {
            background-color: var(--gold-light);
            color: var(--clr-primary);
            border-color: var(--gold-light);
            transform: translateY(-2px);
        }

        /* Navigation Link Styling */
        .nav-link-premium {
            color: var(--clr-primary);
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            padding: 5px 0;
            margin: 0 10px; /* Add some horizontal spacing */
        }

        .nav-link-premium::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background-color: var(--gold-deep);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .nav-link-premium:hover::after {
            width: 100%;
        }

        .nav-link-premium:hover {
            color: var(--clr-emerald-medium); /* Uses defined medium green */
        }

        /* Search Bar Styling */
        .search-container {
            position: relative;
        }

        .search-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gold-deep);
            z-index: 1;
        }

        .search-input {
            padding-left: 40px; /* Make space for the icon */
            border-color: var(--gold-light);
            border-radius: var(--radius-md);
        }

        .search-input:focus {
            border-color: var(--gold-deep);
            box-shadow: 0 0 0 0.25rem rgba(184, 144, 71, 0.25);
        }

        .top-banner {
            background: linear-gradient(135deg, var(--clr-primary), #135835);
            color: var(--gold-shimmer);
            border-bottom: 3px solid var(--gold-deep);
            padding: 10px 0;
        }

        /* Footer Link Styling */
        .footer-link {
            color: var(--gold-shimmer); /* Light gold for links */
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .footer-link:hover {
            color: var(--gold-light); /* Slightly lighter on hover */
            text-decoration: underline;
        }

        .top-banner .bismillah {
            font-family: 'Times New Roman', serif;
            font-size: 1.2rem;
            color: var(--gold-light);
        }
        .navbar-premium {
            border-bottom: 1px solid rgba(184, 144, 71, 0.2);
            box-shadow: 0 10px 30px rgba(11, 61, 36, 0.08); /* Kept shadow */
        }
    </style>
</head>
<body>

    <!-- Divine Ribbon Header -->
    <div class="top-banner w-100 text-center">
        <span class="bismillah">بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ</span>
        <br />
        <small class="text-uppercase tracking-wider" style="font-size: 0.75rem; letter-spacing: 1px;">"In the Name of Allah, the Most Gracious, the Most Merciful" — Al-Barakah Market</small>
    </div>

    <header class="sticky-top bg-white">
        <nav class="navbar navbar-expand-lg navbar-premium navbar-light" style="background-color: var(--clr-primary-light) !important;"> <!-- Override Bootstrap bg-white -->
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-3" asp-area="" asp-page="/Index">
                    <div style="width: 50px; height: 50px; background: linear-gradient(135deg, var(--clr-primary), #1b7245); border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 2px solid var(--gold-deep);">
                        <svg viewBox="0 0 100 100" width="30" height="30">
                            <path d="M 40,15 A 35,35 0 1,0 85,60 A 30,30 0 1,1 45,20 L 48,25 L 32,28 L 38,45 Z" fill="#dfba6b" />
                            <path d="M 50,35 L 52,42 L 59,42 L 53,46 L 55,53 L 50,48 L 45,53 L 47,46 L 41,42 L 48,42 Z" fill="#ffffff" />
                        </svg>
                    </div>
                    <div class="d-flex flex-column">
                        <strong class="text-primary" style="line-height: 1; letter-spacing: 1px;">BARAKAH MARKET</strong>
                        <small style="font-size: 0.65rem; color: var(--gold-deep); text-transform: uppercase; letter-spacing: 1px; font-weight: bold;">Blessed • Reused • Sustained</small>
                    </div>
                    </div> 
                </a>
                
                <!-- Toggle Menu for Mobile -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <!-- Navbar Contents -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <!-- Search Bar in Header -->
                    <form class="d-flex mx-auto my-2 my-lg-0 search-container w-100" method="get" action="/Anuncios/Index">
                        <i class="bi bi-search search-icon"></i>
                        <i class="bi bi-search search-icon"></i> 
                        <input class="form-control search-input w-100" type="search" name="searchString" placeholder="Search items with Barakah..." aria-label="Pesquisar">
                    </form>
                    
                    <ul class="navbar-nav me-3 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Index">
                                <i class="bi bi-house-door"></i> Início
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Anuncios/Index">
                                <i class="bi bi-boxes"></i> Artigos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Colecoes/Index">
                                <i class="bi bi-journal-bookmark"></i> Coleções
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Utilizadores/Index">
                                <i class="bi bi-shield-check"></i> Vendedores
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Favoritos/Index">
                                <i class="bi bi-heart"></i> Favoritos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Mensagens/Index">
                                <i class="bi bi-chat-right-quote"></i> Chat
                            </a>
                        </li>
                    </ul>
                    
                    <!-- Call To Action: Create Listing -->
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2">
                        <a class="btn btn-premium btn-sm px-3" asp-area="" asp-page="/Anuncios/Create">
                        <a class="btn btn-premium btn-sm px-4 fw-bold" asp-area="" asp-page="/Anuncios/Create" style="white-space: nowrap;">
                            <i class="bi bi-plus-circle-fill"></i> Vender Artigo
                        </a>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container my-4 flex-grow-1">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <!-- Comprehensive Al-Barakah Footer -->
    <footer class="footer-premium" style="background-color: var(--clr-primary); border-top: 4px solid var(--gold-deep);">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="mb-3 text-white" style="font-family: 'Times New Roman', serif; letter-spacing: 1px;">AL-BARAKAH SOUQ</h5>
                    <p class="text-light small opacity-75">An online marketplace built specifically upon the principles of Islamic trust, environmental stewardship (Khilafah), and strict rejection of wasteful consumerism.</p>
                    <div style="background-color: rgba(255,255,255,0.05); border: 1px dashed var(--gold-light); padding: 10px; border-radius: 4px;">
                        <p class="small mb-0" style="color: var(--gold-light);"><strong>Note:</strong> We strictly prohibit items containing Riba, non-halal materials, or items that do not adhere to modest community values.</p>
                    </div>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="mb-3 text-uppercase font-weight-bold text-white" style="font-size: 0.85rem; letter-spacing: 0.05em;">Explore</h6>
                    <ul class="list-unstyled">
                        <li><a class="footer-link" asp-page="/Anuncios/Index">All Items</a></li>
                        <li><a class="footer-link" asp-page="/Colecoes/Index">Special Collections</a></li>
                        <li><a class="footer-link" asp-page="/Utilizadores/Index">Sellers</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="mb-3 text-uppercase font-weight-bold text-white" style="font-size: 0.85rem; letter-spacing: 0.05em;">Account</h6>
                    <ul class="list-unstyled">
                        <li><a class="footer-link" asp-area="Identity" asp-page="/Account/Login">Login</a></li>
                        <li><a class="footer-link" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                        <li><a class="footer-link" asp-page="/Favoritos/Index">Favorites</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="mb-3 text-uppercase font-weight-bold text-white" style="font-size: 0.85rem; letter-spacing: 0.05em;">Quranic Inspiration</h6>
                    <p style="font-style: italic; font-size: 0.85rem; color: #a4c2b0;">
                        "The likeness of those who spend their wealth in the way of Allah, is as the likeness of a grain (of corn); it grows seven ears, and each ear has a hundred grains." <br><span style="color: var(--gold-light);">— Al-Baqarah 2:261</span>
                    </p>
                    <a class="footer-link small text-muted" asp-area="" asp-page="/Privacy">Privacy Policy</a>
                </div>
            </div>
            
            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center">
                <p class="mb-2 mb-md-0 opacity-75" style="font-size: 0.85rem;">&copy; 2026 - Al-Barakah Market. Built for the Ummah, honoring the Earth.</p>
                <div class="d-flex gap-3">
                    <a href="#" class="text-white opacity-75"><i class="bi bi-shield-check"></i> Fair Trade</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Standard Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>