<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BazarIPT</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom & Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Proj_finalweb_loja.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- Divine Ribbon Header / Spiritual Awareness Reminder -->
    <div class="top-banner w-100">
        <span class="bismillah">بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ</span>
        <small class="text-uppercase tracking-wider" style="font-size: 0.75rem; letter-spacing: 1px;">
            "Evita o desperdício, pois Alá não ama os deperdiçadores" — Bazar da Comunidade IPT
        </small>
    </div>

    <header class="sticky-top bg-white">
        <nav class="navbar navbar-expand-lg navbar-premium navbar-light">
            <div class="container">
                <!-- Brand Identity -->
                <a class="navbar-brand navbar-brand-premium d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <i class="bi bi-moon-stars-fill fs-4"></i>
                    <span class="d-flex flex-column align-items-start">
                        <strong style="line-height: 1.2;">BazarIPT</strong>
                        <small style="font-size: 0.65rem; color: var(--gold-deep); text-transform: uppercase; letter-spacing: 1px;">Mercado Sustentável</small>
                    </span>
                </a>
                
                <!-- Toggle Menu for Mobile -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <!-- Navbar Contents -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <!-- Search Bar in Header -->
                    <form class="d-flex mx-auto my-2 my-lg-0 search-container w-100" method="get" action="/Anuncios/Index">
                        <i class="bi bi-search search-icon"></i>
                        <input class="form-control search-input w-100" type="search" name="searchString" placeholder="Pesquisar artigos com Barakah..." aria-label="Pesquisar">
                    </form>
                    
                    <ul class="navbar-nav me-3 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Index">
                                <i class="bi bi-house-door"></i> Início
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Anuncios/Index">
                                <i class="bi bi-boxes"></i> Artigos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Colecoes/Index">
                                <i class="bi bi-journal-bookmark"></i> Coleções
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Utilizadores/Index">
                                <i class="bi bi-shield-check"></i> Vendedores
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Favoritos/Index">
                                <i class="bi bi-heart"></i> Favoritos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Mensagens/Index">
                                <i class="bi bi-chat-right-quote"></i> Chat
                            </a>
                        </li>
                    </ul>
                    
                    <!-- Call To Action: Create Listing -->
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2">
                        <a class="btn btn-premium btn-sm px-3" asp-area="" asp-page="/Anuncios/Create">
                            <i class="bi bi-plus-circle-fill"></i> Vender Artigo
                        </a>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container my-4 flex-grow-1">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <!-- Premium Islamic Theme Footer -->
    <footer class="footer-premium">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-moon-stars"></i> BazarIPT
                    </h5>
                    <p class="text-light small opacity-75">O teu marketplace favorito assentado em princípios éticos de comércio honesto, preservação de recursos e combate ao desperdício no Instituto Politécnico de Tomar.</p>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="mb-3 text-uppercase font-weight-bold" style="font-size: 0.85rem; letter-spacing: 0.05em;">Explorar</h6>
                    <ul class="list-unstyled">
                        <li><a class="footer-link" asp-page="/Anuncios/Index">Todos os Artigos</a></li>
                        <li><a class="footer-link" asp-page="/Colecoes/Index">Coleções Especiais</a></li>
                        <li><a class="footer-link" asp-page="/Utilizadores/Index">Vendedores</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="mb-3 text-uppercase font-weight-bold" style="font-size: 0.85rem; letter-spacing: 0.05em;">Conta Coletiva</h6>
                    <ul class="list-unstyled">
                        <li><a class="footer-link" asp-area="Identity" asp-page="/Account/Login">Entrar</a></li>
                        <li><a class="footer-link" asp-area="Identity" asp-page="/Account/Register">Registar</a></li>
                        <li><a class="footer-link" asp-page="/Favoritos/Index">Favoritos</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="mb-3 text-uppercase font-weight-bold" style="font-size: 0.85rem; letter-spacing: 0.05em;">Ética e Transparência</h6>
                    <div class="charity-alert mb-2">
                        <p class="small text-white mb-0"><strong>Nota:</strong> É estritamente proibido anunciar artigos que incluam usura (Riba) ou que infrinjam os padrões de modéstia e respeito da comunidade.</p>
                    </div>
                    <a class="footer-link small text-muted" asp-area="" asp-page="/Privacy">Política de Privacidade</a>
                </div>
            </div>
            
            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center">
                <p class="mb-2 mb-md-0 opacity-75" style="font-size: 0.85rem;">&copy; 2026 - BazarIPT. Promovendo a economia circular e justa.</p>
                <div class="d-flex gap-3">
                    <a href="#" class="text-white opacity-75"><i class="bi bi-shield-check"></i> Comércio Justo</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Standard Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>