<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BazarIPT</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom & Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Proj_finalweb_loja.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-premium navbar-light bg-white">
            <div class="container">
                <!-- Brand Brand -->
                <a class="navbar-brand navbar-brand-premium" asp-area="" asp-page="/Index">
                    <i class="bi bi-shop-window"></i> BazarIPT
                </a>
                
                <!-- Toggle Menu for Mobile -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <!-- Navbar Contents -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <!-- Search Bar in Header -->
                    <form class="d-flex mx-auto my-2 my-lg-0 search-container" method="get" action="/Anuncios/Index">
                        <i class="bi bi-search search-icon"></i>
                        <input class="form-control search-input w-100" type="search" name="searchString" placeholder="Pesquisar artigos em segunda mão..." aria-label="Pesquisar">
                    </form>
                    
                    <ul class="navbar-nav me-3 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Anuncios/Index">
                                <i class="bi bi-grid"></i> Artigos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Colecoes/Index">
                                <i class="bi bi-stars"></i> Coleções
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Utilizadores/Index">
                                <i class="bi bi-people"></i> Vendedores
                            </a>
                        </li>
                    </ul>
                    
                    <!-- Call To Action: Create Listing -->
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2">
                        <a class="btn btn-premium btn-sm" asp-area="" asp-page="/Anuncios/Create">
                            <i class="bi bi-plus-circle"></i> Vender
                        </a>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container my-4 flex-grow-1">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <!-- Premium Footer -->
    <footer class="footer-premium">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="navbar-brand-premium mb-3">
                        <i class="bi bi-shop-window"></i> BazarIPT
                    </h5>
                    <p class="text-muted small">O teu marketplace favorito para comprar e vender artigos em segunda mão no Instituto Politécnico de Tomar. Dá uma segunda vida aos teus objetos!</p>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="mb-3 text-uppercase font-weight-bold" style="font-size: 0.85rem; letter-spacing: 0.05em;">Explorar</h6>
                    <ul class="list-unstyled">
                        <li><a class="footer-link" asp-page="/Anuncios/Index">Todos os Artigos</a></li>
                        <li><a class="footer-link" asp-page="/Colecoes/Index">Coleções Especiais</a></li>
                        <li><a class="footer-link" asp-page="/Utilizadores/Index">Vendedores</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="mb-3 text-uppercase font-weight-bold" style="font-size: 0.85rem; letter-spacing: 0.05em;">Conta</h6>
                    <ul class="list-unstyled">
                        <li><a class="footer-link" asp-area="Identity" asp-page="/Account/Login">Entrar</a></li>
                        <li><a class="footer-link" asp-area="Identity" asp-page="/Account/Register">Registar</a></li>
                        <li><a class="footer-link" asp-page="/Favoritos/Index">Favoritos</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="mb-3 text-uppercase font-weight-bold" style="font-size: 0.85rem; letter-spacing: 0.05em;">Suporte e Privacidade</h6>
                    <p class="text-muted small">Projeto desenvolvido no âmbito da cadeira de Desenvolvimento Web do IPT 2025/2026.</p>
                    <a class="footer-link" asp-area="" asp-page="/Privacy">Política de Privacidade</a>
                </div>
            </div>
            
            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center">
                <p class="mb-2 mb-md-0">&copy; 2026 - BazarIPT. Todos os direitos reservados.</p>
                <div class="d-flex gap-3">
                    <a href="#" class="text-muted"><i class="bi bi-facebook fs-5"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-instagram fs-5"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-twitter-x fs-5"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Floating Chat Bubble Widget -->
    <div class="chat-bubble-container d-print-none">
        <!-- Chat Window -->
        <div id="chatWindow" class="chat-window d-none">
            <div class="chat-window-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-chat-left-text-fill"></i>
                    <span class="fw-bold">Chat BazarIPT</span>
                </div>
                <button id="closeChatBtn" class="btn-close-chat" type="button" title="Fechar Chat">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="chat-window-body">
                <iframe id="chatIframe" src="about:blank" style="width: 100%; height: 100%; border: none;"></iframe>
            </div>
        </div>

        <!-- Chat Bubble Button -->
        <button id="chatBubbleBtn" class="chat-bubble-toggle" type="button" title="Abrir Mensagens">
            <i class="bi bi-chat-dots-fill"></i>
            <span id="chatBubbleBadge" class="chat-badge d-none">0</span>
        </button>
    </div>

    <!-- Standard Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Floating Chat Widget Script -->
    <script>
        $(document).ready(function() {
            const $chatBubbleBtn = $('#chatBubbleBtn');
            const $chatWindow = $('#chatWindow');
            const $closeChatBtn = $('#closeChatBtn');
            const $chatIframe = $('#chatIframe');
            const $chatBubbleBadge = $('#chatBubbleBadge');

            // 1. Polling for unread messages count
            function checkUnreadCount() {
                $.getJSON('/Mensagens/Index?handler=UnreadCount', function(data) {
                    if (data && data.count > 0) {
                        $chatBubbleBadge.text(data.count).removeClass('d-none');
                    } else {
                        $chatBubbleBadge.addClass('d-none');
                    }
                }).fail(function() {
                    console.log('Erro ao obter contagem de mensagens não lidas.');
                });
            }

            // Poll every 10 seconds
            checkUnreadCount();
            setInterval(checkUnreadCount, 10000);

            // 2. Toggle Chat Window
            $chatBubbleBtn.on('click', function() {
                if ($chatWindow.hasClass('d-none')) {
                    // Open Chat
                    $chatWindow.removeClass('d-none');
                    
                    // Lazy load iframe content if not loaded yet
                    if ($chatIframe.attr('src') === 'about:blank') {
                        $chatIframe.attr('src', '/Mensagens/Index?isWidget=true');
                    }
                } else {
                    // Close Chat
                    $chatWindow.addClass('d-none');
                }
            });

            // 3. Close Chat Button
            $closeChatBtn.on('click', function() {
                $chatWindow.addClass('d-none');
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
