<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BazarIPT</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom & Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Proj_finalweb_loja.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-premium navbar-light bg-white">
            <div class="container">
                <!-- Brand Brand -->
                <a class="navbar-brand navbar-brand-premium" asp-area="" asp-page="/Index">
                    <i class="bi bi-shop-window"></i> BazarIPT
                </a>
                
                <!-- Toggle Menu for Mobile -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <!-- Navbar Contents -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <!-- Search Bar in Header -->
                    <form class="d-flex mx-auto my-2 my-lg-0 search-container" method="get" action="/Anuncios/Index">
                        <i class="bi bi-search search-icon"></i>
                        <input class="form-control search-input w-100" type="search" name="searchString" placeholder="Pesquisar artigos em segunda mão..." aria-label="Pesquisar">
                    </form>
                    
                    <ul class="navbar-nav me-3 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Index">
                                <i class="bi bi-house"></i> Início
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Anuncios/Index">
                                <i class="bi bi-grid"></i> Artigos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Favoritos/Index">
                                <i class="bi bi-heart"></i> Favoritos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" asp-area="" asp-page="/Mensagens/Index">
                                <i class="bi bi-chat-left-dots"></i> Chat
                            </a>
                        </li>
                    </ul>
                    
                    <!-- Call To Action: Create Listing -->
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2">
                        <a class="btn btn-premium btn-sm" asp-area="" asp-page="/Anuncios/Create">
                            <i class="bi bi-plus-circle"></i> Vender
                        </a>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container my-4 flex-grow-1">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <!-- Premium Footer -->
    <footer class="footer-premium">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="navbar-brand-premium mb-3">
                        <i class="bi bi-shop-window"></i> BazarIPT
                    </h5>
                    <p class="text-muted small">O teu marketplace favorito para comprar e vender artigos em segunda mão no Instituto Politécnico de Tomar. Dá uma segunda vida aos teus objetos!</p>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="mb-3 text-uppercase font-weight-bold" style="font-size: 0.85rem; letter-spacing: 0.05em;">Explorar</h6>
                    <ul class="list-unstyled">
                        <li><a class="footer-link" asp-page="/Anuncios/Index">Todos os Artigos</a></li>
                        <li><a class="footer-link" asp-page="/Index">Categorias</a></li>
                        <li><a class="footer-link" href="#">Destaques</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="mb-3 text-uppercase font-weight-bold" style="font-size: 0.85rem; letter-spacing: 0.05em;">Conta</h6>
                    <ul class="list-unstyled">
                        <li><a class="footer-link" asp-area="Identity" asp-page="/Account/Login">Entrar</a></li>
                        <li><a class="footer-link" asp-area="Identity" asp-page="/Account/Register">Registar</a></li>
                        <li><a class="footer-link" asp-page="/Favoritos/Index">Favoritos</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="mb-3 text-uppercase font-weight-bold" style="font-size: 0.85rem; letter-spacing: 0.05em;">Suporte e Privacidade</h6>
                    <p class="text-muted small">Projeto desenvolvido no âmbito da cadeira de Desenvolvimento Web do IPT 2025/2026.</p>
                    <a class="footer-link" asp-area="" asp-page="/Privacy">Política de Privacidade</a>
                </div>
            </div>
            
            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center">
                <p class="mb-2 mb-md-0">&copy; 2026 - BazarIPT. Todos os direitos reservados.</p>
                <div class="d-flex gap-3">
                    <a href="#" class="text-muted"><i class="bi bi-facebook fs-5"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-instagram fs-5"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-twitter-x fs-5"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Standard Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
