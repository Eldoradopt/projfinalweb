@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-lg-center">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link nav-link-premium" asp-area="Identity" asp-page="/Account/Manage/Index" title="Gerir Conta">
            <i class="bi bi-person-circle fs-5"></i> Olá @User.Identity?.Name!
        </a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
            <button type="submit" class="nav-link nav-link-premium border-0 bg-transparent">
                <i class="bi bi-box-arrow-right"></i> Sair
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link nav-link-premium" asp-area="Identity" asp-page="/Account/Register">
            <i class="bi bi-person-plus"></i> Registar
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-premium-outline btn-sm ms-lg-2" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right"></i> Entrar
        </a>
    </li>
}
</ul>
