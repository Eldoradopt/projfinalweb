<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chat Widget</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom & Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Proj_finalweb_loja.styles.css" asp-append-version="true" />
    
    <style>
        body {
            background-color: transparent !important;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding: 0 !important;
            margin: 0 !important;
            overflow-x: hidden;
            font-size: 0.9rem;
        }
        .container {
            max-width: 100% !important;
            padding: 0 !important;
        }
    </style>
</head>
<body>
    <div class="flex-grow-1 d-flex flex-column">
        @RenderBody()
    </div>

    <!-- Standard Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Force external full-page links to open in the parent viewport
            document.querySelectorAll('a').forEach(function(link) {
                const href = link.getAttribute('href');
                if (href && !href.startsWith('#') && !href.startsWith('javascript:') && !href.includes('isWidget=true') && !link.getAttribute('target')) {
                    link.setAttribute('target', '_parent');
                }
            });
        });
    </script>
</body>
</html>
