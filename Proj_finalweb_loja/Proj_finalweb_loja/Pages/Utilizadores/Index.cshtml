@page
@model Proj_finalweb_loja.Pages.Utilizadores.IndexModel
@{
    ViewData["Title"] = "Vendedores";
}

<div class="mb-5">
    <h1 class="fw-extrabold h2 mb-1">👥 Vendedores</h1>
    <p class="text-muted">Conhece a comunidade do BazarIPT — vê os perfis, anúncios e reputação de cada vendedor.</p>
</div>

@if (!Model.Vendedores.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-people fs-1 d-block mb-3 text-primary"></i>
        <h5>Nenhum vendedor registado ainda.</h5>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var v in Model.Vendedores)
        {
            <div class="col">
                <a asp-page="/Utilizadores/Perfil" asp-route-id="@v.Utilizador.Id"
                   class="text-decoration-none">
                    <div class="bg-white border border-light shadow-sm h-100 p-4 d-flex flex-column gap-3 position-relative overflow-hidden seller-card"
                         style="border-radius: var(--radius-lg); transition: transform 0.2s, box-shadow 0.2s;">
                        
                        <!-- Avatar + Name -->
                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrWhiteSpace(v.Utilizador.FotoPerfilPath))
                            {
                                <img src="@v.Utilizador.FotoPerfilPath" alt="@v.Utilizador.Nome"
                                     class="rounded-circle shadow-sm"
                                     style="width:64px;height:64px;object-fit:cover;border:3px solid var(--clr-primary-light);" />
                            }
                            else
                            {
                                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-sm"
                                     style="width:64px;height:64px;font-size:1.5rem;background:linear-gradient(135deg,var(--clr-primary),var(--clr-secondary));">
                                    @v.Utilizador.Nome.Substring(0, 1).ToUpper()
                                </div>
                            }
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">@v.Utilizador.Nome</h5>
                                <span class="text-muted small"><i class="bi bi-geo-alt"></i> @(v.Utilizador.Cidade ?? "—")</span>
                            </div>
                        </div>

                        <!-- Stars -->
                        <div class="d-flex align-items-center gap-2">
                            @{
                                double media = v.MediaAvaliacoes;
                                int full = (int)Math.Floor(media);
                                bool half = (media - full) >= 0.5;
                            }
                            <div class="d-flex gap-1" style="color:#f59e0b;">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= full)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else if (i == full + 1 && half)
                                    {
                                        <i class="bi bi-star-half"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star" style="color:#d1d5db;"></i>
                                    }
                                }
                            </div>
                            <span class="text-muted small">
                                @if (v.NumAvaliacoes > 0)
                                {
                                    @($"{media:F1} ({v.NumAvaliacoes} avaliações)")
                                }
                                else
                                {
                                    @("Sem avaliações")
                                }
                            </span>
                        </div>

                        <!-- Stats -->
                        <div class="row g-2 mt-auto">
                            <div class="col-6">
                                <div class="bg-light rounded p-2 text-center" style="border-radius:var(--radius-md);">
                                    <div class="fw-bold text-primary fs-5">@v.NumAnuncios</div>
                                    <div class="text-muted" style="font-size:0.75rem;">Anúncios ativos</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-light rounded p-2 text-center" style="border-radius:var(--radius-md);">
                                    <div class="fw-bold text-success fs-5">@v.NumVendas</div>
                                    <div class="text-muted" style="font-size:0.75rem;">Vendas concluídas</div>
                                </div>
                            </div>
                        </div>

                        <!-- Arrow indicator -->
                        <div class="position-absolute top-0 end-0 p-3 text-muted">
                            <i class="bi bi-arrow-right-circle"></i>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

<style>
    .seller-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(99,102,241,0.15) !important;
    }
</style>
