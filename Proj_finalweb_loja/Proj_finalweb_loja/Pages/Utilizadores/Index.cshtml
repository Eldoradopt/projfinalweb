@page
@model Proj_finalweb_loja.Pages.Utilizadores.IndexModel
@{
    ViewData["Title"] = "Vendedores";
}

<div class="mb-5">
    <h1 class="fw-extrabold h2 mb-1">👥 Vendedores</h1>
    <p class="text-muted">Conhece a comunidade do BazarIPT — vê os perfis, anúncios e reputação de cada vendedor.</p>
</div>

@if (!Model.Vendedores.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-people fs-1 d-block mb-3 text-primary"></i>
        <h5>Nenhum vendedor registado ainda.</h5>
    </div>
}
else
{
    @if (User.Identity.IsAuthenticated)
    {
        @if (Model.Favoritos.Any())
        {
            <div class="mb-4">
                <h4 class="fw-bold text-primary mb-3"><i class="bi bi-heart-fill text-danger me-2"></i>Os meus Vendedores Favoritos</h4>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 mb-5">
                    @foreach (var v in Model.Favoritos)
                    {
                        <partial name="_VendedorCard" model="v" />
                    }
                </div>
                <hr class="my-5 text-muted opacity-25" />
            </div>
        }
        else
        {
            <div class="alert alert-light border shadow-sm p-4 mb-5" style="border-radius: var(--radius-lg);">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-light text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; flex-shrink:0;">
                        <i class="bi bi-heart text-danger fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Ainda não tens vendedores favoritos</h6>
                        <p class="text-muted small mb-0">Visita o perfil de um vendedor para o adicionares aos favoritos e acompanhares as suas novidades de perto!</p>
                    </div>
                </div>
            </div>
        }
    }

    <div class="mb-4">
        @if (User.Identity.IsAuthenticated)
        {
            <h4 class="fw-bold text-dark mb-3"><i class="bi bi-people me-2"></i>Explorar Outros Vendedores</h4>
        }
        
        @if (!Model.OutrosVendedores.Any())
        {
            <p class="text-muted">Não existem outros vendedores disponíveis no momento.</p>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
                @foreach (var v in Model.OutrosVendedores)
                {
                    <partial name="_VendedorCard" model="v" />
                }
            </div>
        }
    </div>
}

<style>
    .seller-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(99,102,241,0.15) !important;
    }
</style>
