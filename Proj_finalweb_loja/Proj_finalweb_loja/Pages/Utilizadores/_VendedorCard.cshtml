@model Proj_finalweb_loja.Pages.Utilizadores.IndexModel.VendedorCard

<div class="col">
    <a asp-page="/Utilizadores/Perfil" asp-route-id="@Model.Utilizador.Id" class="text-decoration-none">
        <div class="bg-white border border-light shadow-sm h-100 p-4 d-flex flex-column gap-3 position-relative overflow-hidden seller-card"
             style="border-radius: var(--radius-lg); transition: transform 0.2s, box-shadow 0.2s;">
            
            @if (Model.Utilizador.Suspeito)
            {
                <div class="position-absolute top-0 start-0 bg-danger text-white px-3 py-1 small rounded-bottom-end shadow-sm" style="font-size:0.75rem; border-bottom-right-radius: 8px; z-index: 5;">
                    <i class="bi bi-shield-exclamation"></i> Conta Suspeita
                </div>
            }
            
            <!-- Avatar + Name -->
            <div class="d-flex align-items-center gap-3">
                @if (!string.IsNullOrWhiteSpace(Model.Utilizador.FotoPerfilPath))
                {
                    <img src="@Model.Utilizador.FotoPerfilPath" alt="@Model.Utilizador.Nome"
                         class="rounded-circle shadow-sm"
                         style="width:64px;height:64px;object-fit:cover;border:3px solid var(--clr-primary-light);" />
                }
                else
                {
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-sm"
                         style="width:64px;height:64px;font-size:1.5rem;background:linear-gradient(135deg,var(--clr-primary),var(--clr-secondary));">
                        @(!string.IsNullOrEmpty(Model.Utilizador.Nome) ? Model.Utilizador.Nome.Substring(0, 1).ToUpper() : "U")
                    </div>
                }
                <div>
                    <h5 class="fw-bold mb-0 text-dark">@Model.Utilizador.Nome</h5>
                    <span class="text-muted small"><i class="bi bi-geo-alt"></i> @(Model.Utilizador.Cidade ?? "—")</span>
                </div>
            </div>

            <!-- Stars -->
            <div class="d-flex align-items-center gap-2">
                @{
                    double media = Model.MediaAvaliacoes;
                    int full = (int)Math.Floor(media);
                    bool half = (media - full) >= 0.5;
                }
                <div class="d-flex gap-1" style="color:#f59e0b;">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= full)
                        {
                            <i class="bi bi-star-fill"></i>
                        }
                        else if (i == full + 1 && half)
                        {
                            <i class="bi bi-star-half"></i>
                        }
                        else
                        {
                            <i class="bi bi-star" style="color:#d1d5db;"></i>
                        }
                    }
                </div>
                <span class="text-muted small">
                    @if (Model.NumAvaliacoes > 0)
                    {
                        @($"{media:F1} ({Model.NumAvaliacoes} avaliações)")
                    }
                    else
                    {
                        @("Sem avaliações")
                    }
                </span>
            </div>

            <!-- Stats -->
            <div class="row g-2 mt-auto">
                <div class="col-6">
                    <div class="bg-light rounded p-2 text-center" style="border-radius:var(--radius-md);">
                        <div class="fw-bold text-primary fs-5">@Model.NumAnuncios</div>
                        <div class="text-muted" style="font-size:0.75rem;">Anúncios ativos</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="bg-light rounded p-2 text-center" style="border-radius:var(--radius-md);">
                        <div class="fw-bold text-success fs-5">@Model.NumVendas</div>
                        <div class="text-muted" style="font-size:0.75rem;">Vendas concluídas</div>
                    </div>
                </div>
            </div>

            <!-- Arrow indicator -->
            <div class="position-absolute top-0 end-0 p-3 text-muted">
                <i class="bi bi-arrow-right-circle"></i>
            </div>
        </div>
    </a>
</div>
